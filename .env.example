# Secrets consumed by config.yaml through ${VAR} expansion. Copy to .env.
PROWLARR_URL=http://192.168.1.26:9696
PROWLARR_KEY=
TORBOX_KEY=
QBIT_URL=http://192.168.1.26:8080
QBIT_USER=
QBIT_PASS=
# Dev only: host folder mounted as the "downloads" storage of the api container.
DEV_STORAGE_ROOT=./data/storage
# Prod only: uid:gid the container runs as (must be allowed to write the NAS mounts).
PUID=1000
PGID=1000
